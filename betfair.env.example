# Copy this file to betfair.env and fill in YOUR OWN Betfair details.
# betfair.env stays on your computer -- never share it, never post it.
BF_USERNAME=you@example.com
# your Betfair password (if you use 2-step login, add the 6-digit code to the end)
BF_PASSWORD=your_password
# a LIVE application key from https://developer.betfair.com (not the delayed key)
BF_APP_KEY=your_live_app_key
# optional: folder holding your client-2048.crt / client-2048.key (certificate login).
# Leave it out to use the simpler interactive login.
#BF_CERT_DIR=C:\betfair\certs
